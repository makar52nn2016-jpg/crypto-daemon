# Trudyagi configuration — OpenAI-compatible LLM
# Copy to .env and fill in your values, OR run: python trudyagi.py init

# === Required for `run` command (skip for `demo` mode) ===
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Optional tuning ===
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3

# === Shared worklog (auto-detected if not set) ===
# Local dev: /home/z/my-project/worklog.md
# GitHub Actions: ./worklog.md
# TRUDYAGI_WORKLOG=/home/z/my-project/worklog.md

# === Secrets for Operator to use ===
# These are inherited from the daemon's env vars on GitHub Actions
# GH_TOKEN, TG_TOKEN, TG_CHAT, FRANTIC_AGENT_TOKEN, PIMLICO_API_KEY
